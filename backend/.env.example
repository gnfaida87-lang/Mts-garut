# Backend Environment Variables — MTs Garut
# Copy to .env and fill in values before running wrangler deploy

# JWT Secrets (gunakan string acak yang panjang)
JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-min-32

# CORS Origin (domain frontend yang diizinkan)
CORS_ORIGIN=https://ppi-madrasah.com,https://admin.ppi-madrasah.com

# Cloudflare D1
D1_DATABASE_ID=your-d1-database-id-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Token QR (opsional; default dipakai jika kosong)
QR_DAUROH_TOKEN=PPI_DAUROH_QR_2026
QR_ABSENSI_TOKEN=PPI_ABSENSI_QR_2026

# Window jam absensi guru (format HH:MM:SS, waktu WIB)
# Kosongkan untuk memakai default: masuk 06:30-10:00, keluar 11:00-15:00
JAM_MASUK_MULAI=06:30:00
JAM_MASUK_SELESAI=10:00:00
JAM_KELUAR_MULAI=11:00:00
JAM_KELUAR_SELESAI=15:00:00

# Window jam absensi musyrifah at-Ta'wid/Dauroh (format HH:MM:SS, waktu WIB)
# Kosongkan untuk memakai default: masuk 06:30-07:00, keluar 08:00-09:00
DAUROH_JAM_MASUK_MULAI=06:30:00
DAUROH_JAM_MASUK_SELESAI=07:00:00
DAUROH_JAM_KELUAR_MULAI=08:00:00
DAUROH_JAM_KELUAR_SELESAI=09:00:00
